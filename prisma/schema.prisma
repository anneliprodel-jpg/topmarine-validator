generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SourceReference {
  id             String           @id @default(cuid())
  key            String           @unique
  filename       String
  location       String
  sourceDate     String?
  evidenceStatus String
  note           String?
  products       ProductVariant[]
  rules          ValidationRule[]
}

model ProductVariant {
  id                 String          @id @default(cuid())
  internalId         String          @unique
  code               String
  variant            String
  kind               String
  name               String
  widthM             Float?
  lengthM            Float?
  floatsPerModule    Int?
  floatVolumeL       Int?
  heightPdfM         Float?
  heightWorkbookM    Float?
  freeboardPdfM      Float?
  freeboardWorkbookM Float?
  loadKnPerM2        Float?
  loadKg             Int?
  weightKg           Int?
  sourceId           String
  source             SourceReference @relation(fields: [sourceId], references: [id])
  sourceLocation     String
  evidenceStatus     String
  reviewRequired     Boolean         @default(false)
  notes              String?
  sortOrder          Int             @default(0)

  @@unique([code, variant])
  @@index([code])
}

model SourceConflict {
  id          String @id @default(cuid())
  key         String @unique
  property    String
  title       String
  description String
  sourceA     String
  sourceB     String
  status      String
  sortOrder   Int    @default(0)
}

model ValidationRule {
  id             String           @id @default(cuid())
  ruleId         String           @unique
  version        String
  title          String
  description    String
  status         String
  evidenceStatus String
  isAssumption   Boolean          @default(false)
  sourceId       String?
  source         SourceReference? @relation(fields: [sourceId], references: [id])
  sortOrder      Int              @default(0)
}

model Submission {
  id                          String           @id @default(cuid())
  type                        String
  projectName                 String           @default("")
  customerName                String           @default("")
  requestedDeliveryDate       DateTime?
  referenceText               String           @default("")
  comments                    String           @default("")
  modulesConnected            String?
  connectionDescription       String           @default("")
  connectionComponents        String           @default("")
  connectionQuantitiesUnknown Boolean          @default(false)
  anchoringType               String?
  anchoringDetails            String           @default("")
  shoreConnection             String?
  gangwayDetails              String           @default("")
  shoreSupportDetails         String           @default("")
  shoreDetailsUnknown         Boolean          @default(false)
  siteNotes                   String           @default("")
  winterUse                   Boolean?
  siteWaveHeightM             Float?
  siteCurrentSpeedMs          Float?
  boatLengthM                 Float?
  relevantProperties          String[]
  isDemo                      Boolean          @default(false)
  source                      String           @default("MANUAL")
  extractionStatus            String           @default("NONE")
  extractionStage             String?
  extractionError             String?
  extractionProvider          String?
  extractionModel             String?
  extractionVersion           String?
  extractionStartedAt         DateTime?
  extractionFinishedAt        DateTime?
  extraction                  Json?
  evidence                    Json?
  conflicts                   Json?
  corrections                 Json?
  documents                   SourceDocument[]
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
  lines                       SubmissionLine[]
  runs                        ValidationRun[]

  @@index([updatedAt])
}

model SubmissionLine {
  id                    String     @id @default(cuid())
  submissionId          String
  submission            Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  position              Int
  variant               String?
  code                  String?
  customName            String?
  quantity              Int?
  statedWidthM          Float?
  statedLengthM         Float?
  statedFloatsPerModule Int?
  statedFloatsTotal     Int?

  @@index([submissionId])
}

model ValidationRun {
  id             String     @id @default(cuid())
  submissionId   String
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  ruleVersion    String
  submissionType String
  overallStatus  String
  inputSnapshot  Json
  evidence       Json?
  conflicts      Json?
  documents      Json?
  extractor      Json?
  report         Json

  @@index([submissionId, createdAt])
}

model SourceDocument {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  index        Int
  fileName     String
  kind         String?
  byteSize     Int        @default(0)
  status       String
  message      String?
  ocrUsed      Boolean    @default(false)
  units        Json?
  createdAt    DateTime   @default(now())

  @@index([submissionId])
}
