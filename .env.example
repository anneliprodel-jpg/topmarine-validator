# Kõik väärtused seadistatakse Renderi veebiteenuse Environment-sektsioonis (serveri keskkonnamuutujad).
# Ära pane päris võtmeid ega paroole GitHubi ega vestlusesse.

# Render PostgreSQL "Internal Database URL" (kopeeri otse andmebaasi lehelt)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Automaatne analüüs (Anthropic Claude API). Kasutus on TASULINE (Anthropic arveldab API kasutuse eraldi; Claude.ai tellimus API võtit ei anna).
# Võtme saab Anthropic Console'ist (console.anthropic.com -> API keys).
ANTHROPIC_API_KEY=""
# Valikuline: mudel (vaikimisi claude-opus-5-5; odavam valik nt claude-sonnet-5-5) ja põhjendamise tase (low | medium | high; vaikimisi medium)
# LLM_MODEL="claude-opus-5-5"
# LLM_EFFORT="medium"

# Analüüsi kaitse. Tootmises on analüüs KEELATUD, kuni see on seadistatud: mõtle välja pikk juhuslik kood ja anna see ainult kasutajatele.
ANALYSIS_ACCESS_CODE=""
# Valikuline: analüüside päevapiir kokku (vaikimisi 30)
# ANALYSIS_DAILY_LIMIT="30"
