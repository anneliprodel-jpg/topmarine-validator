{
  "name": "topmarine-validator",
  "version": "0.1.0",
  "private": true,
  "description": "Top Marine SP Order Checker - õppetöö MVP (demo)",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && tsx prisma/seed.ts && next start -H 0.0.0.0 -p ${PORT:-3000}",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "next": "15.5.28",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  },
  "devDependencies": {
    "vitest": "^3.2.0"
  }
}
